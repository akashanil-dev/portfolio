---
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const host = new URL(project.url).host;
---

<a
  href={project.url}
  target="_blank"
  rel="noopener noreferrer"
  class="project-card"
  aria-label={`${project.name} — ${project.tagline} (opens ${host})`}
>
  <!-- Little browser-window chrome -->
  <div class="project-chrome" aria-hidden="true">
    <span class="dot dot--r"></span>
    <span class="dot dot--y"></span>
    <span class="dot dot--g"></span>
    <span class="project-url">{host}</span>
  </div>

  <div class="project-body">
    <h3 class="project-name">{project.name}</h3>
    <p class="project-tagline">{project.tagline}</p>
    <p class="project-blurb">{project.blurb}</p>

    <div class="project-footer">
      <div class="project-tags">
        {project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
      </div>
      <span class="project-visit">Visit ↗</span>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-solid);
    border-radius: 10px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: translateY(-3px) rotate(-0.4deg);
    border-color: var(--accent-dim);
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.35);
  }

  .project-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    background: var(--bg-overlay);
    border-bottom: 1px solid var(--border-solid);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot--r { background: #f87171; }
  .dot--y { background: #fbbf24; }
  .dot--g { background: #4ade80; }

  .project-url {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-dim);
    background: var(--bg);
    border-radius: 4px;
    padding: 0.15em 0.6em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1.1rem;
  }

  .project-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
  }

  .project-tagline {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-text);
    margin-bottom: 0.85rem;
  }

  .project-blurb {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.65;
    margin-bottom: 1.1rem;
  }

  .project-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-dim);
    border: 1px solid var(--border-solid);
    border-radius: 3px;
    padding: 0.15em 0.55em;
  }

  .project-visit {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
    transition: color 0.15s ease;
  }

  .project-card:hover .project-visit {
    color: var(--accent-text);
  }

  /* ── Light theme: cards sit lighter than the page, softer hover ── */
  :global([data-theme="light"]) .project-card {
    background: #fdfdfc;
  }
  :global([data-theme="light"]) .project-chrome {
    background: var(--bg-elevated);
  }
  :global([data-theme="light"]) .project-url {
    background: #fdfdfc;
    border: 1px solid var(--border-solid);
  }
  :global([data-theme="light"]) .project-card:hover,
  :global([data-theme="light"]) .project-card:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 10px 28px -14px rgba(17, 24, 39, 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
