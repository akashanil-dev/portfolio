---
interface ArticleSchema {
  title: string;
  description?: string;
  publishDate?: Date;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  personSchema?: boolean;
  articleSchema?: ArticleSchema;
  hasMermaid?: boolean;
}

const {
  title,
  description = "Infrastructure systems, Linux, observability, and the architecture beneath modern software.",
  ogImage = "/og-image.png",
  canonicalUrl,
  type = "website",
  personSchema = false,
  articleSchema,
  hasMermaid = false,
} = Astro.props;

const siteUrl = "https://akashanil.dev";
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;

const personJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Akash A",
    url: siteUrl,
    sameAs: [
      "https://www.linkedin.com/in/akashanil-dev",
      "https://github.com/akashanil-dev",
      "https://meta.wikimedia.org/wiki/User:Akash_A",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "akashanil.dev",
    url: siteUrl,
    author: {
      "@type": "Person",
      name: "Akash A",
    },
  },
];

const articleJsonLd = articleSchema
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: articleSchema.title,
      description: articleSchema.description,
      url: articleSchema.url,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": articleSchema.url,
      },
      datePublished: articleSchema.publishDate?.toISOString(),
      author: {
        "@type": "Person",
        name: "Akash A",
        url: `${siteUrl}/about`,
      },
      publisher: {
        "@type": "Person",
        name: "Akash A",
        url: siteUrl,
      },
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="akashanil.dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- RSS Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="akashanil.dev"
      href="/rss.xml"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/favicon.webp" />

    <!-- Structured Data -->
    {personSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    )}
    {articleJsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}


    <!-- Theme init: runs synchronously before paint to prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      />
    </noscript>

    <!-- Mermaid diagram renderer (only on pages with diagrams) -->
    {hasMermaid && <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      // ── Modal singleton ──────────────────────────────────────────────────────
      function getModal() {
        let modal = document.getElementById('mermaid-modal');
        if (modal) return modal;

        modal = document.createElement('div');
        modal.id = 'mermaid-modal';
        modal.setAttribute('role', 'dialog');
        modal.setAttribute('aria-modal', 'true');
        modal.setAttribute('aria-label', 'Diagram expanded view');
        modal.innerHTML = `
          <div class="mermaid-modal__backdrop"></div>
          <div class="mermaid-modal__box">
            <div class="mermaid-modal__toolbar">
              <span class="mermaid-modal__label">diagram</span>
              <button class="mermaid-modal__close" aria-label="Close diagram">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <line x1="2" y1="2" x2="14" y2="14"/>
                  <line x1="14" y1="2" x2="2" y2="14"/>
                </svg>
                <span>close</span>
              </button>
            </div>
            <div class="mermaid-modal__content"></div>
          </div>
        `;
        document.body.appendChild(modal);

        const closeBtn = modal.querySelector('.mermaid-modal__close');
        const backdrop = modal.querySelector('.mermaid-modal__backdrop');

        function closeModal() {
          modal.classList.remove('mermaid-modal--open');
          document.body.style.overflow = '';
          modal.querySelector('.mermaid-modal__content').innerHTML = '';
        }

        closeBtn.addEventListener('click', closeModal);
        backdrop.addEventListener('click', closeModal);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal.classList.contains('mermaid-modal--open')) {
            closeModal();
          }
        });

        return modal;
      }

      function openModal(svgSource) {
        const modal = getModal();
        const content = modal.querySelector('.mermaid-modal__content');
        content.innerHTML = svgSource;
        // Make the SVG fill the modal content area
        const svg = content.querySelector('svg');
        if (svg) {
          svg.style.maxWidth = '100%';
          svg.style.height = 'auto';
          svg.style.display = 'block';
          svg.style.margin = '0 auto';
        }
        modal.classList.add('mermaid-modal--open');
        document.body.style.overflow = 'hidden';
        modal.querySelector('.mermaid-modal__close').focus();
      }

      // ── Add expand button to a rendered diagram wrapper ──────────────────────
      function addExpandButton(wrapper) {
        const btn = document.createElement('button');
        btn.className = 'mermaid-expand-btn';
        btn.setAttribute('aria-label', 'View diagram fullscreen');
        btn.innerHTML = `
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 2 2 2 2 6"/>
            <polyline points="12 2 14 2 14 6"/>
            <polyline points="4 14 2 14 2 10"/>
            <polyline points="12 14 14 14 14 10"/>
            <line x1="2" y1="2" x2="6" y2="6"/>
            <line x1="14" y1="2" x2="10" y2="6"/>
            <line x1="2" y1="14" x2="6" y2="10"/>
            <line x1="14" y1="14" x2="10" y2="10"/>
          </svg>
          expand
        `;

        btn.addEventListener('click', () => {
          const svg = wrapper.querySelector('svg');
          if (svg) openModal(svg.outerHTML);
        });

        // Make wrapper relative so button positions correctly
        wrapper.style.position = 'relative';
        wrapper.appendChild(btn);
      }

      // ── Mermaid init ─────────────────────────────────────────────────────────
      function initMermaid() {
        const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'default',
          themeVariables: isDark
            ? {
                background: '#13161c',
                primaryColor: '#1e2330',
                primaryTextColor: '#e2e4e9',
                primaryBorderColor: '#1e2330',
                lineColor: '#4ade80',
                secondaryColor: '#181c24',
                tertiaryColor: '#0f1115',
                edgeLabelBackground: '#13161c',
                clusterBkg: '#181c24',
                titleColor: '#e2e4e9',
                nodeTextColor: '#e2e4e9',
                fontFamily: '"JetBrains Mono", "Fira Code", monospace',
              }
            : {
                background: '#f7f7f5',
                primaryColor: '#e8e7e3',
                primaryTextColor: '#111827',
                primaryBorderColor: '#d6d3cc',
                lineColor: '#15803d',
                secondaryColor: '#f0efec',
                tertiaryColor: '#f7f7f5',
                edgeLabelBackground: '#f7f7f5',
                clusterBkg: '#f0efec',
                titleColor: '#111827',
                nodeTextColor: '#111827',
                fontFamily: '"JetBrains Mono", "Fira Code", monospace',
              },
        });

        // Astro 5 / Shiki puts data-language on <pre>, not a class on <code>
        const preBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
        const diagrams = [];

        for (const pre of preBlocks) {
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid-diagram';

          // Shiki wraps each line in <span class="line">; join them with newlines
          const lineSpans = pre.querySelectorAll('.line');
          if (lineSpans.length > 0) {
            wrapper.textContent = Array.from(lineSpans)
              .map(l => l.textContent)
              .join('\n');
          } else {
            const codeEl = pre.querySelector('code');
            wrapper.textContent = (codeEl ?? pre).textContent;
          }

          pre.replaceWith(wrapper);
          diagrams.push(wrapper);
        }

        if (diagrams.length > 0) {
          mermaid.run({ nodes: diagrams }).then(() => {
            // Inject expand button after SVG has been rendered into each wrapper
            for (const wrapper of diagrams) {
              if (wrapper.querySelector('svg')) {
                addExpandButton(wrapper);
              }
            }
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMermaid);
      } else {
        initMermaid();
      }
    </script>}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ── Dark theme (default) ── */
  :root,
  [data-theme="dark"] {
    --bg: #0f1115;
    --bg-elevated: #13161c;
    --bg-overlay: #181c24;
    --bg-card: #13161c;
    --border: rgba(255, 255, 255, 0.07);
    --border-solid: #1e2330;

    --ink: #e2e4e9;
    --ink-muted: #a0abbe;
    --ink-dim: #7a8aa0;
    --ink-subtle: #6b7a94;

    --accent: #4ade80;
    --accent-muted: #22c55e;
    --accent-dim: #16a34a;
    --accent-text: #86efac;
    --accent-bg: rgba(74, 222, 128, 0.06);
    --accent-bg-hover: rgba(74, 222, 128, 0.1);

    --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", "IBM Plex Mono", "Fira Code", monospace;

    --max-w: 760px;
    --max-w-wide: 1024px;

    color-scheme: dark;
  }

  /* ── Light theme — editorial engineering notebook ── */
  [data-theme="light"] {
    /* Backgrounds — warm off-white, not pure white */
    --bg: #f7f7f5;
    --bg-elevated: #f0efec;
    --bg-overlay: #e8e7e3;
    --bg-card: #ececea;
    --border: rgba(0, 0, 0, 0.06);
    --border-solid: #d6d3cc;

    /* Ink — graphite hierarchy, strong enough at small sizes */
    --ink: #111827;
    --ink-muted: #374151;
    --ink-dim: #4b5563;
    --ink-subtle: #6b7280;

    /* Accent — muted forest green, terminal-inspired */
    --accent: #15803d;
    --accent-muted: #166534;
    --accent-dim: #14532d;
    --accent-text: #166534;
    --accent-bg: rgba(21, 128, 61, 0.08);
    --accent-bg-hover: rgba(21, 128, 61, 0.13);

    --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", "IBM Plex Mono", "Fira Code", monospace;

    --max-w: 760px;
    --max-w-wide: 1024px;

    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
  }

  /* Smooth theme transition — only on intentional toggle, not on load */
  html.theme-transitioning,
  html.theme-transitioning *,
  html.theme-transitioning *::before,
  html.theme-transitioning *::after {
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.15s ease !important;
  }

  body {
    background-color: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
  }

  ::selection {
    background-color: rgba(74, 222, 128, 0.18);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 5px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border-solid);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--ink-subtle);
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border-solid) var(--bg);
  }

  /* ── Light mode overrides — fix hardcoded dark-mode values ── */

  /* Code blocks — keep dark in light mode so Shiki tokens stay readable */
  [data-theme="light"] .prose pre {
    background: #1a1d23 !important;
    border-color: #2a2e3a;
    color: #e2e4e9;
  }
  [data-theme="light"] .prose :not(pre) > code {
    background: #e4e2dc;
    border-color: #cbc8be;
    color: var(--accent-text);
  }
  [data-theme="light"] .prose blockquote {
    background: rgba(21, 128, 61, 0.05);
    border-left-color: var(--accent-dim);
    color: var(--ink-muted);
  }
  [data-theme="light"] .prose th {
    background: var(--bg-elevated);
    border-color: var(--border-solid);
  }
  [data-theme="light"] .prose td {
    border-color: var(--border-solid);
  }
  [data-theme="light"] .prose tr:nth-child(even) td {
    background: rgba(0, 0, 0, 0.025);
  }
  [data-theme="light"] .prose tr:hover td {
    background: var(--bg-elevated);
  }
  [data-theme="light"] .prose img {
    border-color: var(--border-solid);
  }
  [data-theme="light"] ::selection {
    background-color: rgba(21, 128, 61, 0.14);
    color: var(--ink);
  }

  /* Cards — title hover: dark mode uses #fff, light mode uses deep ink */
  [data-theme="light"] .card:hover .card__title,
  [data-theme="light"] .card-editorial:hover .card-editorial__title,
  [data-theme="light"] .card-compact:hover .card-compact__title {
    color: var(--ink) !important;
  }

  /* Card hover backgrounds: replace rgba(255,255,255,...) with dark wash */
  [data-theme="light"] .card:hover {
    background: var(--bg-overlay);
    border-color: rgba(21, 128, 61, 0.3);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  }
  [data-theme="light"] .card-editorial:hover {
    background: rgba(0, 0, 0, 0.025);
    border-left-color: rgba(21, 128, 61, 0.4);
  }
  [data-theme="light"] .card-compact:hover {
    background: rgba(0, 0, 0, 0.02);
    border-left-color: rgba(21, 128, 61, 0.32);
  }

  /* Default card featured tint */
  [data-theme="light"] .card--featured {
    border-color: rgba(21, 128, 61, 0.14);
  }

  /* Tag borders: replace dark rgba with proper light values */
  [data-theme="light"] .card__tag,
  [data-theme="light"] .card-compact__tag {
    border-color: rgba(21, 128, 61, 0.2);
  }

  /* Nav hover bg: rgba(255,255,255,0.04) is invisible on light bg */
  [data-theme="light"] .nav-link:hover,
  [data-theme="light"] .nav-link--active {
    background: rgba(0, 0, 0, 0.05);
  }
  [data-theme="light"] .nav-link--active::after {
    background: rgba(21, 128, 61, 0.6);
  }
  [data-theme="light"] .nav-link--github:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  [data-theme="light"] .mobile-nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  [data-theme="light"] .mobile-menu-btn:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  [data-theme="light"] .theme-toggle:hover {
    background: rgba(0, 0, 0, 0.07);
  }

  /* Hero button: secondary border was rgba(255,255,255,0.12) — invisible */
  [data-theme="light"] .hero-btn:hover {
    border-color: rgba(0, 0, 0, 0.15);
    background: var(--bg-overlay);
    color: var(--ink);
  }
  [data-theme="light"] .hero-btn--ghost:hover {
    background: var(--bg-elevated);
    border-color: var(--border-solid);
  }

  /* Topic chip hover — replace green rgba with light-safe values */
  [data-theme="light"] .topic-chip:hover {
    color: var(--accent-text);
    border-color: rgba(21, 128, 61, 0.25);
    background: rgba(21, 128, 61, 0.07);
  }

  /* ───────────── Prose / Markdown Styles ───────────── */
  .prose {
    color: var(--ink);
    line-height: 1.8;
    max-width: none;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: var(--ink);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2.25em;
    margin-bottom: 0.75em;
    font-family: var(--font-sans);
  }

  .prose h1 {
    font-size: 1.875rem;
    margin-top: 0;
  }
  .prose h2 {
    font-size: 1.35rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.45em;
  }
  .prose h3 {
    font-size: 1.1rem;
    color: var(--ink-muted);
  }
  .prose h4 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .prose p {
    margin-bottom: 1.3em;
  }

  .prose a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-dim);
    transition: color 0.15s ease;
  }
  .prose a:hover {
    color: var(--accent);
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose em {
    color: var(--ink-muted);
    font-style: italic;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.5em;
    margin-bottom: 1.25em;
  }
  .prose li {
    margin-bottom: 0.45em;
  }
  .prose li::marker {
    color: var(--ink-subtle);
  }

  .prose blockquote {
    border-left: 3px solid var(--accent-dim);
    padding: 0.5em 1.25em;
    margin: 1.75em 0;
    color: var(--ink-muted);
    font-style: italic;
    background: var(--accent-bg);
    border-radius: 0 4px 4px 0;
  }

  /* Code blocks */
  .prose pre {
    background: var(--bg-elevated) !important;
    border: 1px solid var(--border-solid);
    border-radius: 6px;
    padding: 1.25em 1.5em;
    overflow-x: auto;
    margin: 1.75em 0;
    font-family: var(--font-mono);
    font-size: 0.84em;
    line-height: 1.65;
    position: relative;
  }

  /* Shiki token colors — preserve shiki output, just set base */
  .prose pre code {
    font-family: var(--font-mono);
    font-size: inherit;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }

  /* Inline code */
  .prose :not(pre) > code {
    background: var(--bg-overlay);
    border: 1px solid var(--border-solid);
    border-radius: 3px;
    padding: 0.15em 0.42em;
    font-family: var(--font-mono);
    font-size: 0.84em;
    color: var(--accent-text);
  }

  /* Tables */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75em 0;
    font-size: 0.875em;
    display: block;
    overflow-x: auto;
  }
  .prose th {
    background: var(--bg-elevated);
    border: 1px solid var(--border-solid);
    padding: 0.55em 1em;
    text-align: left;
    font-weight: 500;
    color: var(--ink-muted);
    font-size: 0.78em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .prose td {
    border: 1px solid var(--border-solid);
    padding: 0.55em 1em;
    color: var(--ink);
    vertical-align: top;
  }
  .prose tr:nth-child(even) td {
    background: rgba(255, 255, 255, 0.015);
  }
  .prose tr:hover td {
    background: var(--bg-elevated);
  }

  .prose img {
    max-width: 100%;
    border-radius: 6px;
    border: 1px solid var(--border-solid);
    margin: 1.75em 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border-solid);
    margin: 2.75em 0;
  }

  /* ── Mermaid Diagram Container ── */
  .mermaid-diagram {
    margin: 1.75em 0;
    padding: 1.5em;
    background: var(--bg-elevated);
    border: 1px solid var(--border-solid);
    border-radius: 6px;
    overflow-x: auto;
    text-align: center;
    position: relative;
  }

