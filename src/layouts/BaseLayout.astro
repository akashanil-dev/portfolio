---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Infrastructure systems, Linux, observability, and the architecture beneath modern software.",
  ogImage = "/og-image.png",
  canonicalUrl,
  type = "website",
} = Astro.props;

const siteUrl = "https://akashanil.dev";
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="akashanil.dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- RSS Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="akashanil.dev"
      href="/rss.xml"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.webp" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      />
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1115;
    --bg-elevated: #13161c;
    --bg-overlay: #181c24;
    --border: rgba(255, 255, 255, 0.07);
    --border-solid: #1e2330;

    --ink: #e2e4e9;
    --ink-muted: #8892a4;
    --ink-subtle: #525d72;

    --accent: #4ade80;
    --accent-muted: #22c55e;
    --accent-dim: #16a34a;
    --accent-text: #86efac;
    --accent-bg: rgba(74, 222, 128, 0.06);
    --accent-bg-hover: rgba(74, 222, 128, 0.1);

    --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", "IBM Plex Mono", "Fira Code", monospace;

    --max-w: 760px;
    --max-w-wide: 1024px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
  }

  ::selection {
    background-color: rgba(74, 222, 128, 0.18);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 5px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border-solid);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--ink-subtle);
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border-solid) var(--bg);
  }

  /* ───────────── Prose / Markdown Styles ───────────── */
  .prose {
    color: var(--ink);
    line-height: 1.8;
    max-width: none;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: var(--ink);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2.25em;
    margin-bottom: 0.75em;
    font-family: var(--font-sans);
  }

  .prose h1 {
    font-size: 1.875rem;
    margin-top: 0;
  }
  .prose h2 {
    font-size: 1.35rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.45em;
  }
  .prose h3 {
    font-size: 1.1rem;
    color: var(--ink-muted);
  }
  .prose h4 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .prose p {
    margin-bottom: 1.3em;
  }

  .prose a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-dim);
    transition: color 0.15s ease;
  }
  .prose a:hover {
    color: var(--accent);
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose em {
    color: var(--ink-muted);
    font-style: italic;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.5em;
    margin-bottom: 1.25em;
  }
  .prose li {
    margin-bottom: 0.45em;
  }
  .prose li::marker {
    color: var(--ink-subtle);
  }

  .prose blockquote {
    border-left: 3px solid var(--accent-dim);
    padding: 0.5em 1.25em;
    margin: 1.75em 0;
    color: var(--ink-muted);
    font-style: italic;
    background: var(--accent-bg);
    border-radius: 0 4px 4px 0;
  }

  /* Code blocks */
  .prose pre {
    background: var(--bg-elevated) !important;
    border: 1px solid var(--border-solid);
    border-radius: 6px;
    padding: 1.25em 1.5em;
    overflow-x: auto;
    margin: 1.75em 0;
    font-family: var(--font-mono);
    font-size: 0.84em;
    line-height: 1.65;
    position: relative;
  }

  /* Shiki token colors — preserve shiki output, just set base */
  .prose pre code {
    font-family: var(--font-mono);
    font-size: inherit;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }

  /* Inline code */
  .prose :not(pre) > code {
    background: var(--bg-overlay);
    border: 1px solid var(--border-solid);
    border-radius: 3px;
    padding: 0.15em 0.42em;
    font-family: var(--font-mono);
    font-size: 0.84em;
    color: var(--accent-text);
  }

  /* Tables */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75em 0;
    font-size: 0.875em;
    display: block;
    overflow-x: auto;
  }
  .prose th {
    background: var(--bg-elevated);
    border: 1px solid var(--border-solid);
    padding: 0.55em 1em;
    text-align: left;
    font-weight: 500;
    color: var(--ink-muted);
    font-size: 0.78em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .prose td {
    border: 1px solid var(--border-solid);
    padding: 0.55em 1em;
    color: var(--ink);
    vertical-align: top;
  }
  .prose tr:nth-child(even) td {
    background: rgba(255, 255, 255, 0.015);
  }
  .prose tr:hover td {
    background: var(--bg-elevated);
  }

  .prose img {
    max-width: 100%;
    border-radius: 6px;
    border: 1px solid var(--border-solid);
    margin: 1.75em 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border-solid);
    margin: 2.75em 0;
  }
</style>
