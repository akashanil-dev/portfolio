---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/site/SiteNav.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
---

<BaseLayout
  title="About Akash A — Developer & Wikimedia Contributor | akashanil.dev"
  description="Akash A is an MCA student, developer, and Wikimedia contributor focused on Linux infrastructure, observability, and cloud-native systems."
  personSchema={true}
>
  <SiteNav />

  <main class="about-main">
    <div class="about-wrap">
      <header class="about-header">
        <span class="about-label">About</span>
        <h1 class="about-title">Akash A</h1>
      </header>

      <div class="about-body">
        <p>
          I'm an MCA student exploring Linux infrastructure, observability,
          cloud-native systems, and how modern software architecture evolved.
          This site is a public notebook — a place to document what I learn, the
          systems I build, and the thinking behind them.
        </p>

        <p>
          I'm also a <a href="https://meta.wikimedia.org/wiki/User:Akash_A" target="_blank" rel="noopener noreferrer">Wikimedia contributor</a>,
          working on open-source and Wikimedia technology projects.
        </p>

        <p>
          My focus areas right now: Linux internals, container runtimes,
          observability tooling (Prometheus, Grafana, OpenTelemetry), reverse
          proxies, and the layers that exist between application code and
          bare metal.
        </p>

        <p>
          I believe in learning by building. Most of what's on this site came
          from running things locally, hitting something unexpected, and working
          through it. The labs are the work. The essays are the thinking.
        </p>

        <hr class="about-divider" />

        <div class="about-currently">
          <h2 class="about-section-heading">Currently</h2>
          <p>
            Pursuing an MCA and building out this site. Actively contributing to
            Wikimedia projects and exploring Linux internals, container runtimes,
            and observability tooling.
          </p>
        </div>

        <hr class="about-divider" />

        <div class="about-structure">
          <h2 class="about-section-heading">This site</h2>
          <p>
            The content is organized into three distinct types:
          </p>
          <ul class="about-structure__list">
            <li><strong>Labs</strong> — hands-on build logs. Real infrastructure, real commands, real debugging.</li>
            <li><strong>Essays</strong> — long-form systems thinking. Why things work the way they do.</li>
            <li><strong>Notes</strong> — short references, cheatsheets, and things worth writing down.</li>
          </ul>
        </div>

        <hr class="about-divider" />

        <div class="about-links">
          <h2 class="about-links__heading">Links</h2>
          <ul class="about-links__list">
            <li>
              <a
                href="https://github.com/akashanil-dev"
                target="_blank"
                rel="noopener noreferrer"
                class="about-link"
              >
                <span class="about-link__label">GitHub</span>
                <span class="about-link__handle">github.com/akashanil-dev ↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://linkedin.com/in/akashanil-dev"
                target="_blank"
                rel="noopener noreferrer"
                class="about-link"
              >
                <span class="about-link__label">LinkedIn</span>
                <span class="about-link__handle">linkedin.com/in/akashanil-dev ↗</span>
              </a>
            </li>
            <li>
              <a
                href="https://meta.wikimedia.org/wiki/User:Akash_A"
                target="_blank"
                rel="noopener noreferrer"
                class="about-link"
              >
                <span class="about-link__label">Wikimedia</span>
                <span class="about-link__handle">meta.wikimedia.org/wiki/User:Akash_A ↗</span>
              </a>
            </li>
            <li>
              <a
                href="mailto:akashanil084@gmail.com"
                class="about-link"
              >
                <span class="about-link__label">Email</span>
                <span class="about-link__handle">akashanil084@gmail.com</span>
              </a>
            </li>
            <li>
              <a href="/rss.xml" class="about-link">
                <span class="about-link__label">RSS</span>
                <span class="about-link__handle">akashanil.dev/rss.xml</span>
              </a>
            </li>
          </ul>
        </div>

        <hr class="about-divider" />

        <div class="about-stack">
          <h2 class="about-section-heading">Site stack</h2>
          <p class="about-stack__note">
            Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
            (static output, content collections, Shiki syntax highlighting),
            styled with vanilla CSS,
            deployed on <a href="https://vercel.com" target="_blank" rel="noopener noreferrer">Vercel</a>.
            Content is Markdown via Astro Content Collections.
          </p>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .about-main {
    padding: 4rem 0 6rem;
  }

  .about-wrap {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .about-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
  }

  .about-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .about-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    max-width: 62ch;
  }

  .about-body p {
    font-size: 0.95rem;
    color: var(--ink-muted);
    line-height: 1.8;
  }

  .about-body a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-dim);
    transition: color 0.15s ease;
  }
  .about-body a:hover {
    color: var(--accent);
  }

  .about-divider {
    border: none;
    border-top: 1px solid var(--border-solid);
    margin: 0.5rem 0;
  }

  .about-links__heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .about-links__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    transition: none;
  }

  .about-link__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-subtle);
    min-width: 56px;
  }

  .about-link__handle {
    font-size: 0.875rem;
    color: var(--ink-muted);
    transition: color 0.15s ease;
  }
  .about-link:hover .about-link__handle {
    color: var(--accent-text);
  }

  .about-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-stack__note {
    font-size: 0.85rem;
    color: var(--ink-subtle);
    line-height: 1.7;
  }

  /* Shared heading style for Currently / This site / Site stack */
  .about-section-heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .about-currently p,
  .about-structure p {
    font-size: 0.95rem;
    color: var(--ink-muted);
    line-height: 1.8;
  }

  .about-structure__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.5rem;
  }

  .about-structure__list li {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.7;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border-solid);
  }

  .about-structure__list strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
