---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteNav from "@/components/site/SiteNav.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import { getCollection } from "astro:content";

const allNotes = await getCollection("notes", ({ data }) => !data.draft);
const notes = allNotes.sort(
  (a, b) =>
    new Date(b.data.publishDate).getTime() -
    new Date(a.data.publishDate).getTime()
);
---

<BaseLayout
  title="Notes — akashanil.dev"
  description="Short technical notes, command references, and things worth writing down."
>
  <SiteNav />

  <main class="page-main">
    <div class="page-wrap">
      <header class="page-header">
        <span class="page-label">Notes</span>
        <h1 class="page-title">Quick references</h1>
        <p class="page-desc">
          Short technical notes, command references, and things worth writing
          down.
        </p>
      </header>

      {
        notes.length > 0 ? (
          <div class="notes-list">
            {notes.map((note) => (
              <PostCard
                title={note.data.title}
                description={note.data.description}
                href={`/notes/${note.slug}`}
                tags={note.data.tags}
                readingTime={note.data.readingTime}
                publishDate={note.data.publishDate}
                variant="compact"
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">No notes published yet. Check back soon.</p>
        )
      }
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .page-main {
    padding: 4rem 0 5rem;
  }
  .page-wrap {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .page-header {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .page-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .page-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .page-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 52ch;
  }
  .notes-list {
    display: flex;
    flex-direction: column;
    max-width: 640px;
  }
  .empty-state {
    font-size: 0.85rem;
    color: var(--ink-subtle);
    padding: 3rem 0;
  }
</style>
